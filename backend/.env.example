# .env.example
# DO NOT ADD REAL SECRETS HERE.

ENVIRONMENT=development

# Database
# Use sqlite for local development
DATABASE_URL=sqlite:///../data/bot.db

# Security
JWT_SECRET_KEY=change_this_to_a_random_string_for_local_dev

# Trading Engine Modes
DATA_MODE=live
EXECUTION_MODE=paper
RESEARCH_MODE=true
SYNTHETIC_BOOTSTRAP=false
LIVE_TRADING_ENABLED=false
