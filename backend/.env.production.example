# .env.production.example
# DO NOT ADD REAL SECRETS HERE.
# Copy this to .env on the production VPS and update the values.

ENVIRONMENT=production

# Database (PostgreSQL)
POSTGRES_USER=jonanda
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=jonanda_db
# DATABASE_URL is set in docker-compose using the above variables, but if running raw:
# DATABASE_URL=postgresql://jonanda:your_secure_postgres_password@localhost:5432/jonanda_db

# Security
JWT_SECRET_KEY=generate_a_very_long_random_string_using_openssl_rand_hex_32

# Trading Engine Modes
DATA_MODE=live
EXECUTION_MODE=paper
RESEARCH_MODE=true
SYNTHETIC_BOOTSTRAP=false

# CRITICAL SAFETY
# NEVER SET THIS TO TRUE UNLESS PHASE 6 IS COMPLETE AND REAL CAPITAL IS APPROVED
LIVE_TRADING_ENABLED=false
